# ===========================================================================
#  Energy Recovery Voice Agent — configuration template
# ===========================================================================
#  Copy to `.env` (same folder) and fill in what you need:
#      copy .env.example .env
#
#  THIS FILE IS ENTIRELY OPTIONAL.
#
#  The demo runs end-to-end with every value below left blank. With no keys:
#    * the Python rules engine handles all extraction (no LLM needed),
#    * the browser handles speech in (Web Speech API) and out (SpeechSynthesis),
#    * the warm handoff is queued on screen instead of transferred.
#
#  Nothing here changes who makes a decision. The state machine, the validators
#  and the safety engine are always authoritative — an LLM key only improves
#  wording and messy-input tolerance.
#
#  AFTER EDITING: restart the backend. The startup banner prints exactly which
#  providers it picked up. If your key does not appear there, it was not read.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. LLM — optional. Extraction + phrasing only. It never decides anything.
# ---------------------------------------------------------------------------
# Default below is Groq: free tier, no credit card, and very fast.
# Sign up -> https://console.groq.com/keys  then paste the key after LLM_API_KEY=
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Using Google Gemini instead? (also free) ------------------------------
# Key -> https://aistudio.google.com/apikey
#   LLM_PROVIDER=gemini
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash

# --- Using OpenAI instead? (paid — there is no free tier) ------------------
# Key -> https://platform.openai.com/api-keys
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

# NOTE: LLM_BASE_URL and LLM_MODEL must match the provider you put the key in
# for. A Groq key sent to api.openai.com will simply fail and the agent quietly
# falls back to the rules engine — the call still works, you just lose the
# phrasing polish.


# ---------------------------------------------------------------------------
# 2. SPEECH-TO-TEXT — optional. The browser already transcribes for free.
# ---------------------------------------------------------------------------
# Only useful if you want server-side transcription, or you are demoing in a
# browser without the Web Speech API (Firefox, for example). Enables
# POST /calls/{id}/audio, which accepts a raw audio body and feeds the
# transcript through the same safety and validation pipeline as any other turn.
#
# Deepgram — $200 free credit, no credit card, no expiry. https://deepgram.com
DEEPGRAM_API_KEY=

# AssemblyAI — $50 free credit. https://www.assemblyai.com
# ASSEMBLYAI_API_KEY=

# Force one provider when both are set. Unset -> Deepgram, then AssemblyAI.
# STT_PROVIDER=deepgram

# Give up on a transcription after this many seconds.
# STT_TIMEOUT_SECONDS=25

# Uploaded call recordings (POST /recordings/upload) are whole calls, so they get longer.
# STT_UPLOAD_TIMEOUT_SECONDS=180


# ---------------------------------------------------------------------------
# 3. TELEPHONY (Twilio) — optional. Needed only for REAL phone calls.
# ---------------------------------------------------------------------------
# With these set, the recovery console gets a "Start call by agent" button: the
# assistant phones the customer, listens and answers in real time, and on a
# handoff dials a human agent into the SAME call. Without them everything still
# works in the browser and this whole section can stay blank.
#
# To turn it on, fill in ALL of the following, then restart the backend. The
# startup banner says "Phone calls: ON" (or lists exactly what is missing).
#
# 1) Twilio credentials — https://console.twilio.com (Account Info panel).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 2) A Twilio phone number that can place calls, in +E.164 form (+61...).
TWILIO_FROM_NUMBER=
# 3) A public HTTPS address Twilio can reach this backend on. Twilio fetches its
#    call instructions from here, so localhost will not work. For local use:
#        ngrok http 8000
#    then paste the https://xxxx.ngrok-free.app address it prints (no trailing /).
#    Restart the backend whenever the tunnel address changes.
PUBLIC_BASE_URL=
# 4) The human agent's phone (+E.164). On a handoff, this number is called and
#    joined to the customer's live call after a spoken briefing (press 1 to join).
#    Blank -> handoffs on a phone call end with a "we'll call you back" message.
HANDOFF_TRANSFER_NUMBER=
#
# Twilio TRIAL accounts can only call numbers verified in the console (Phone
# Numbers -> Verified Caller IDs), and play a short "trial account" message
# first. The seeded leads have synthetic numbers, so for testing set this to
# your own verified phone: every "Start call by agent" then rings it instead of
# the lead's number.
TWILIO_DIAL_OVERRIDE_NUMBER=
#
# How the assistant sounds and listens on the phone (defaults shown).
# TWILIO_SAY_VOICE also accepts Twilio's basic voices, e.g. "alice".
TWILIO_SAY_VOICE=Polly.Nicole
TWILIO_SPEECH_LANGUAGE=en-AU
#
# Reject webhook requests that Twilio did not sign. Keep this on: those
# endpoints are public and one of them can dial a phone. Set to false only when
# testing the webhooks by hand with curl.
TWILIO_VALIDATE_SIGNATURE=true


# ---------------------------------------------------------------------------
# 4. LOCAL OVERRIDES — rarely needed.
# ---------------------------------------------------------------------------
# Move the SQLite file (default: backend/energy_recovery.db)
# DATABASE_URL=sqlite:///./energy_recovery.db
# Skip auto-seeding the 7 synthetic leads on startup
# SKIP_SEED=1
